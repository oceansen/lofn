# ---- Core ----
DATABASE_URL=postgres://lofn:lofn@localhost:5432/lofn
# Public URL of the app (used in exports and secure-cookie decisions)
APP_URL=http://localhost:3000

# ---- Accounts ----
# The first account administers the instance. Everyone else gets their own private projects.
# SETUP_CODE=                       # required to create that first account on a public server
# SIGNUP_MODE=open                  # open | approval | domains | closed (default policy; editable under Users)
# ALLOWED_EMAIL_DOMAINS=sintef.no   # for SIGNUP_MODE=domains
# Google sign-in: create an OAuth client (Web) at console.cloud.google.com → APIs & Services → Credentials,
# authorised redirect URI: <APP_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GitHub sign-in: github.com/settings/developers → New OAuth App,
# authorization callback URL: <APP_URL>/api/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---- AI (bring your own key) ----
# The server holds no AI provider keys. Each account adds its own Hugging Face, Anthropic or OpenAI key
# under AI settings in the app; a project's AI work runs on its owner's key. Provider env keys are ignored.
# Saved keys are encrypted with SECRETS_KEY (any long random string). Keep it stable: changing it makes
# saved keys unreadable. If unset, a key is generated in a file next to the storage directory.
SECRETS_KEY=
# Default models offered to new accounts (each account can change them):
# HF_MODEL=Qwen/Qwen3.8-27B
# HF_VISION_MODEL=Qwen/Qwen3.8-27B
# HF_ASR_MODEL=openai/whisper-large-v3-turbo
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-4o
# OPENAI_TRANSCRIPTION_MODEL=whisper-1

# ---- Synthesis loop ----
# SYNTHESIS_INTERVAL_SECONDS=60
# FINAL_SYNTHESIS_WAIT_SECONDS=180

# ---- Media storage ----
STORAGE_DRIVER=local               # local | s3
STORAGE_DIR=./storage
# S3_BUCKET=
# S3_REGION=eu-north-1
# S3_ENDPOINT=                     # for MinIO / R2 / other S3-compatible stores
# S3_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Limits ----
# MAX_IMAGE_MB=15
# MAX_AUDIO_MB=50
# MAX_VIDEO_MB=250
# MAX_VIDEO_ANALYSE_SECONDS=600

# ---- Worker ----
# WORKER_CONCURRENCY=4
