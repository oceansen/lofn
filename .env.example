# ---- Core ----
DATABASE_URL=postgres://lofn:lofn@localhost:5432/lofn
# Public URL of the app (used in exports and secure-cookie decisions)
APP_URL=http://localhost:3000

# ---- Accounts ----
# The first account administers the instance. Everyone else gets their own private projects.
# SETUP_CODE=                       # required to create that first account on a public server
# SIGNUP_MODE=open                  # open | approval | domains | closed (default policy; editable under Users)
# ALLOWED_EMAIL_DOMAINS=sintef.no   # for SIGNUP_MODE=domains
# Google sign-in: create an OAuth client (Web) at console.cloud.google.com → APIs & Services → Credentials,
# authorised redirect URI: <APP_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GitHub sign-in: github.com/settings/developers → New OAuth App,
# authorization callback URL: <APP_URL>/api/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---- AI providers (server-side only; never exposed to the browser) ----
# Provider and model per job can also be chosen in the app: Admin → AI models (overrides these defaults).
# Hugging Face Inference Providers (open models: Qwen, Llama, Gemma, GLM, DeepSeek, Whisper …)
HF_TOKEN=                          # fine-grained token with "Make calls to Inference Providers"
# HF_MODEL=Qwen/Qwen3.8-27B          # synthesis (append :provider to pin one, e.g. :together)
# HF_VISION_MODEL=Qwen/Qwen3.8-27B   # image/video interpretation (vision-language model)
# HF_ASR_MODEL=openai/whisper-large-v3-turbo
# Synthesis + image/video interpretation. Pick one, or leave both empty for the labelled development fallback.
# AI_PROVIDER=anthropic            # anthropic | openai | huggingface | none  (auto-detected from keys when unset)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint (Azure, vLLM, Ollama…)
# Audio/video transcription (OpenAI-compatible /audio/transcriptions). Defaults to openai when OPENAI_API_KEY is set.
# TRANSCRIPTION_PROVIDER=openai    # openai | huggingface | none
# OPENAI_TRANSCRIPTION_MODEL=whisper-1

# ---- Synthesis loop ----
# SYNTHESIS_INTERVAL_SECONDS=60
# FINAL_SYNTHESIS_WAIT_SECONDS=180

# ---- Media storage ----
STORAGE_DRIVER=local               # local | s3
STORAGE_DIR=./storage
# S3_BUCKET=
# S3_REGION=eu-north-1
# S3_ENDPOINT=                     # for MinIO / R2 / other S3-compatible stores
# S3_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Limits ----
# MAX_IMAGE_MB=15
# MAX_AUDIO_MB=50
# MAX_VIDEO_MB=250
# MAX_VIDEO_ANALYSE_SECONDS=600

# ---- Worker ----
# WORKER_CONCURRENCY=4
