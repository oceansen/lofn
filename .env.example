# ---- Core ----
DATABASE_URL=postgres://lofn:lofn@localhost:5432/lofn
# Public URL of the app (used in exports and secure-cookie decisions)
APP_URL=http://localhost:3000

# ---- AI providers (server-side only; never exposed to the browser) ----
# Synthesis + image/video interpretation. Pick one, or leave both empty for the labelled development fallback.
# AI_PROVIDER=anthropic            # anthropic | openai | none  (auto-detected from keys when unset)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint (Azure, vLLM, Ollama…)
# Audio/video transcription (OpenAI-compatible /audio/transcriptions). Defaults to openai when OPENAI_API_KEY is set.
# TRANSCRIPTION_PROVIDER=openai
# OPENAI_TRANSCRIPTION_MODEL=whisper-1

# ---- Synthesis loop ----
# SYNTHESIS_INTERVAL_SECONDS=60
# FINAL_SYNTHESIS_WAIT_SECONDS=180

# ---- Media storage ----
STORAGE_DRIVER=local               # local | s3
STORAGE_DIR=./storage
# S3_BUCKET=
# S3_REGION=eu-north-1
# S3_ENDPOINT=                     # for MinIO / R2 / other S3-compatible stores
# S3_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Limits ----
# MAX_IMAGE_MB=15
# MAX_AUDIO_MB=50
# MAX_VIDEO_MB=250
# MAX_VIDEO_ANALYSE_SECONDS=600

# ---- Worker ----
# WORKER_CONCURRENCY=4
